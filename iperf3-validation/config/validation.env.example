# OpenShift iperf3 node-pair validation configuration
# Copy this file to validation.env and edit local values.

# Artifact location. If ARTIFACT_DIR is unset, a timestamped directory under ARTIFACT_ROOT is used.
ARTIFACT_ROOT="./runs"
# ARTIFACT_DIR=""

# Temporary namespace for iperf3 server/client pods.
VALIDATION_NAMESPACE="iperf3-validation"

# Published OpenShift network testing image. Replace with an internal mirror if required.
IPERF3_IMAGE="ghcr.io/tomazb/openshift-testing/network-testing-image:latest"

# Required selected node pair.
IPERF3_SERVER_NODE=""
IPERF3_CLIENT_NODE=""
# Optional override. Defaults to the server node InternalIP from the Kubernetes Node object.
IPERF3_SERVER_ADDRESS=""

# Test profile. TCP is the default lower-blast-radius baseline.
IPERF3_PROTOCOL="tcp"
IPERF3_DURATION_SECONDS="30"
IPERF3_PORT="5201"
IPERF3_PARALLEL="1"
IPERF3_SOCKET_BUFFER="256M"
IPERF3_INTERFACE="auto"

# UDP-only settings. IPERF3_PACKET_SIZE=auto derives payload from interface MTU.
IPERF3_BANDWIDTH="0"
IPERF3_PACKET_SIZE="auto"

# true enables hostNetwork, hostPID, and privileged containers for host-level CoreOS diagnostics.
# false keeps hostNetwork but collects only best-effort pod-visible metrics.
IPERF3_PRIVILEGED_MODE="true"

# Optional verdict thresholds. Leave empty to gate only on setup and iperf failures.
IPERF3_MIN_TCP_GBPS=""
IPERF3_MAX_UDP_LOSS_PERCENT=""
