# network-validation configuration
# Copy to validation.env and adjust as needed.

# --- Pod image ---
# The container image used for iperf3 server/client pods.
# Default uses the repo's network-testing-image from GHCR.
IPERF_IMAGE="ghcr.io/tomazb/openshift-testing/network-testing-image:latest"

# --- Namespace ---
IPERF_NAMESPACE="network-validation"

# --- Node placement ---
# Leave empty for auto-selection (picks two different worker nodes).
IPERF_SERVER_NODE=""
IPERF_CLIENT_NODE=""

# --- Host network ---
# Set to "true" for host-network mode (bypasses overlay).
IPERF_HOST_NETWORK="false"

# --- iperf3 test parameters ---
IPERF_DURATION="30"
IPERF_BANDWIDTH="0"
IPERF_PROTOCOL="udp"
IPERF_PACKET_SIZE="8972"
IPERF_SOCKET_BUFFER="256M"
IPERF_PARALLEL="1"
IPERF_PORT="5201"

# --- Thresholds for verdict ---
# Minimum acceptable throughput in Gbps (0 = skip check).
IPERF_MIN_THROUGHPUT_GBPS="0"
# Maximum acceptable packet loss percentage (UDP).
IPERF_MAX_LOSS_PERCENT="1"
# Maximum acceptable retransmits (TCP, 0 = skip check).
IPERF_MAX_RETRANSMITS="0"
