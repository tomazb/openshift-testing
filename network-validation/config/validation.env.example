# network-validation configuration
# Copy to validation.env and adjust as needed.

# --- Pod image ---
# The container image used for iperf3 server/client pods.
# Default uses the repo's network-testing-image from GHCR.
IPERF_IMAGE="ghcr.io/tomazb/openshift-testing/network-testing-image:latest"

# --- Namespace ---
IPERF_NAMESPACE="network-validation"

# --- Node placement ---
# Leave empty for auto-selection (picks two different worker nodes).
IPERF_SERVER_NODE=""
IPERF_CLIENT_NODE=""
# Optional override for the address the client connects to.
IPERF_SERVER_ADDRESS=""

# --- Host network ---
# Set to "true" for host-network mode (bypasses overlay).
IPERF_HOST_NETWORK="false"
# Leave empty to match host-network mode. Set "false" for best-effort restricted host-network metrics.
IPERF_PRIVILEGED_MODE=""

# --- iperf3 test parameters ---
IPERF_DURATION="30"
IPERF_BANDWIDTH="0"
IPERF_PROTOCOL="tcp"
IPERF_PACKET_SIZE="auto"
# Leave empty to use iperf3/kernel defaults. Set a value such as "4M" only when the cluster permits it.
IPERF_SOCKET_BUFFER=""
IPERF_PARALLEL="1"
IPERF_PORT="5201"
IPERF_INTERFACE="auto"
IPERF_SERVER_READY_TIMEOUT="30"

# --- Thresholds for verdict ---
# Minimum acceptable throughput in Gbps (0 = skip check).
IPERF_MIN_THROUGHPUT_GBPS="0"
# Maximum acceptable packet loss percentage (UDP).
IPERF_MAX_LOSS_PERCENT="1"
# Maximum acceptable retransmits (TCP, 0 = skip check).
IPERF_MAX_RETRANSMITS="0"

# --- Node-level metrics collection ---
# Duration in seconds for the dedicated node-metrics subcommand.
NODE_METRICS_DURATION="120"
# Protocol for the dedicated node-metrics run.
NODE_METRICS_PROTOCOL="tcp"

# --- Extended metrics (opt-in) ---
# Set to "true" to enable extended metric collection in ALL iperf3 tests.
# Adds softirqs, TCP/UDP counters, sockstat, PSI, mpstat, and ethtool stats
# to every test run. No verdict impact — extra files are for manual inspection.
IPERF_DEEP_METRICS="false"
