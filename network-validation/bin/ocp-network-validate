#!/usr/bin/env bash
# OpenShift network validation automation with text menu frontend.
set -Eeuo pipefail

SCRIPT_NAME="$(basename "$0")"
export SCRIPT_NAME
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
CONFIG_FILE="$PROJECT_DIR/config/validation.env"
CONFIG_FILE_EXPLICIT="false"
ACTION="menu"
ACTION_ARGS=()
export AUTO_YES="false"

usage() {
  cat <<USAGE
Usage: $SCRIPT_NAME [--config FILE] [--yes] <action>

Actions:
  menu                 Interactive text frontend
  init                 Check local tools and create artifact directories
  preflight            Capture cluster and network baseline
  deploy               Deploy iperf3 server and client pods
  cross-node           Run cross-node pod network test
  same-node            Run same-node pod network test
  host-network         Run host-network test (bypasses overlay)
  pod-to-service       Run pod-to-service test via ClusterIP
  node-metrics         Run dedicated node-level metrics collection (deep, 120 s by default)
  ovn-diagnostics      Capture OVN-Kubernetes diagnostics
  report               Generate markdown report
  cleanup              Delete validation namespace
  all                  Run recommended sequence
  show-paths           Show artifact paths

Examples:
  bash bin/ocp-network-validate --config config/validation.env menu
  bash bin/ocp-network-validate preflight
  bash bin/ocp-network-validate --yes all
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -c|--config)
      [[ $# -ge 2 && -n "${2:-}" && "${2:0:1}" != "-" ]] || { echo "ERROR: --config requires a file path" >&2; exit 2; }
      CONFIG_FILE="$2"
      CONFIG_FILE_EXPLICIT="true"
      shift 2
      ;;
    -y|--yes) AUTO_YES="true"; shift ;;
    -h|--help) usage; exit 0 ;;
    *)
      ACTION="$1"
      shift
      # shellcheck disable=SC2034  # reserved for future per-action arguments
      ACTION_ARGS=("$@")
      break
      ;;
  esac
done

if [[ -f "$CONFIG_FILE" && -r "$CONFIG_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
elif [[ "$CONFIG_FILE_EXPLICIT" == "true" ]]; then
  echo "ERROR: --config file not found or not readable: $CONFIG_FILE" >&2
  exit 2
fi

# --- Defaults ---
RUN_ID="${RUN_ID:-$(date +%Y%m%d-%H%M%S)}"
ARTIFACT_ROOT="${ARTIFACT_ROOT:-$PROJECT_DIR/runs}"
ARTIFACT_DIR="${ARTIFACT_DIR:-$ARTIFACT_ROOT/$RUN_ID}"
KUBECONFIG="${KUBECONFIG:-$HOME/.kube/config}"
IPERF_IMAGE="${IPERF_IMAGE:-ghcr.io/tomazb/openshift-testing/network-testing-image:latest}"
IPERF_NAMESPACE="${IPERF_NAMESPACE:-network-validation}"
IPERF_SERVER_NODE="${IPERF_SERVER_NODE:-}"
IPERF_CLIENT_NODE="${IPERF_CLIENT_NODE:-}"
IPERF_SERVER_ADDRESS="${IPERF_SERVER_ADDRESS:-}"
IPERF_HOST_NETWORK="${IPERF_HOST_NETWORK:-false}"
IPERF_PRIVILEGED_MODE="${IPERF_PRIVILEGED_MODE:-}"
IPERF_DURATION="${IPERF_DURATION:-30}"
IPERF_BANDWIDTH="${IPERF_BANDWIDTH:-0}"
IPERF_PROTOCOL="${IPERF_PROTOCOL:-tcp}"
IPERF_PACKET_SIZE="${IPERF_PACKET_SIZE:-auto}"
IPERF_SOCKET_BUFFER="${IPERF_SOCKET_BUFFER:-}"
IPERF_PARALLEL="${IPERF_PARALLEL:-1}"
IPERF_PORT="${IPERF_PORT:-5201}"
IPERF_INTERFACE="${IPERF_INTERFACE:-auto}"
IPERF_SERVER_READY_TIMEOUT="${IPERF_SERVER_READY_TIMEOUT:-30}"
IPERF_MIN_THROUGHPUT_GBPS="${IPERF_MIN_THROUGHPUT_GBPS:-0}"
IPERF_MAX_LOSS_PERCENT="${IPERF_MAX_LOSS_PERCENT:-1}"
IPERF_MAX_RETRANSMITS="${IPERF_MAX_RETRANSMITS:-0}"
NODE_METRICS_DURATION="${NODE_METRICS_DURATION:-120}"
NODE_METRICS_PROTOCOL="${NODE_METRICS_PROTOCOL:-tcp}"
IPERF_DEEP_METRICS="${IPERF_DEEP_METRICS:-false}"

# --- Config validation ---
config_error() {
  echo "ERROR: Invalid config: $*" >&2
  exit 2
}

validate_positive_integer() {
  local name="$1" value="$2"
  [[ "$value" =~ ^[1-9][0-9]*$ ]] || config_error "$name must be a positive integer"
}

validate_non_negative_number() {
  local name="$1" value="$2"
  [[ "$value" =~ ^([0-9]+([.][0-9]+)?|[.][0-9]+)$ ]] || config_error "$name must be a non-negative number"
}

validate_non_negative_integer() {
  local name="$1" value="$2"
  [[ "$value" =~ ^[0-9]+$ ]] || config_error "$name must be a non-negative integer"
}

validate_packet_size() {
  local value="$1"
  [[ "$value" == "auto" || "$value" =~ ^[1-9][0-9]*$ ]] || config_error "IPERF_PACKET_SIZE must be auto or a positive integer"
}

validate_config() {
  validate_positive_integer IPERF_DURATION "$IPERF_DURATION"
  validate_packet_size "$IPERF_PACKET_SIZE"
  validate_positive_integer IPERF_PARALLEL "$IPERF_PARALLEL"
  validate_positive_integer IPERF_PORT "$IPERF_PORT"
  validate_positive_integer IPERF_SERVER_READY_TIMEOUT "$IPERF_SERVER_READY_TIMEOUT"
  validate_non_negative_number IPERF_MIN_THROUGHPUT_GBPS "$IPERF_MIN_THROUGHPUT_GBPS"
  validate_non_negative_number IPERF_MAX_LOSS_PERCENT "$IPERF_MAX_LOSS_PERCENT"
  validate_non_negative_integer IPERF_MAX_RETRANSMITS "$IPERF_MAX_RETRANSMITS"

  case "$IPERF_PROTOCOL" in
    udp|tcp) ;;
    *) config_error "IPERF_PROTOCOL must be udp or tcp" ;;
  esac

  case "$IPERF_HOST_NETWORK" in
    true|false) ;;
    *) config_error "IPERF_HOST_NETWORK must be true or false" ;;
  esac

  case "$IPERF_PRIVILEGED_MODE" in
    ""|true|false) ;;
    *) config_error "IPERF_PRIVILEGED_MODE must be true, false, or empty" ;;
  esac
  validate_positive_integer NODE_METRICS_DURATION "$NODE_METRICS_DURATION"
  case "$NODE_METRICS_PROTOCOL" in
    udp|tcp) ;;
    *) config_error "NODE_METRICS_PROTOCOL must be udp or tcp" ;;
  esac
  case "$IPERF_DEEP_METRICS" in
    true|false) ;;
    *) config_error "IPERF_DEEP_METRICS must be true or false" ;;
  esac
}

validate_config

export LOG_FILE="$ARTIFACT_DIR/ocp-network-validate.log"
export RUNTIME_ENV="$ARTIFACT_DIR/runtime.env"
export KUBECONFIG

mkdir -p "$ARTIFACT_DIR"

# shellcheck source=../lib/common.sh
# shellcheck disable=SC1091
source "$PROJECT_DIR/lib/common.sh"
# shellcheck source=../lib/cluster.sh
# shellcheck disable=SC1091
source "$PROJECT_DIR/lib/cluster.sh"
# shellcheck source=../lib/deploy.sh
# shellcheck disable=SC1091
source "$PROJECT_DIR/lib/deploy.sh"
# shellcheck source=../lib/metrics.sh
# shellcheck disable=SC1091
source "$PROJECT_DIR/lib/metrics.sh"
# shellcheck source=../lib/iperf.sh
# shellcheck disable=SC1091
source "$PROJECT_DIR/lib/iperf.sh"
# shellcheck source=../lib/results.sh
# shellcheck disable=SC1091
source "$PROJECT_DIR/lib/results.sh"

menu() {
  init_dirs
  while true; do
    cat <<MENU

OpenShift Network Validation
Artifact directory: $ARTIFACT_DIR
Namespace:          $IPERF_NAMESPACE

  1) Init/check local tools
  2) Preflight cluster + network baseline
  3) Deploy iperf3 server and client pods
  4) Run cross-node pod network test
  5) Run same-node pod network test
  6) Run host-network test
  7) Run pod-to-service test
  8) Capture OVN-Kubernetes diagnostics
  9) Generate markdown report
 10) Cleanup validation namespace
 11) Run recommended sequence
 12) Show artifact paths
 13) Run node-level metrics collection
  q) Quit
MENU
    read -r -p "Select action: " choice
    case "$choice" in
      1) init_action ;;
      2) preflight ;;
      3) deploy_pods ;;
      4) run_cross_node ;;
      5) run_same_node ;;
      6) run_host_network ;;
      7) run_pod_to_service ;;
      8) ovn_diagnostics ;;
      9) report ;;
      10) cleanup_action ;;
      11) all_actions ;;
      12) show_paths ;;
      13) run_node_metrics ;;
      q|Q) break ;;
      *) echo "Invalid choice." ;;
    esac
  done
}

case "$ACTION" in
  menu) menu ;;
  init) init_action ;;
  preflight) preflight ;;
  deploy) deploy_pods ;;
  cross-node) run_cross_node ;;
  same-node) run_same_node ;;
  host-network) run_host_network ;;
  pod-to-service) run_pod_to_service ;;
  node-metrics) run_node_metrics ;;
  ovn-diagnostics) ovn_diagnostics ;;
  report) report ;;
  cleanup) cleanup_action ;;
  all) all_actions ;;
  show-paths) show_paths ;;
  -h|--help) usage; exit 0 ;;
  *) echo "Unknown action: $ACTION" >&2; usage >&2; exit 2 ;;
esac
